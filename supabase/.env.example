# Edge Functions sirlari. Mijoz ilovalariga hech qachon berilmaydi.
# Ichki kalitlar (karta tokeni, Wi-Fi, sessiya, OTP) Vault'da avtomatik yaratilgan.

# SMS (Eskiz). Bo'sh bo'lsa kod yuborilmaydi va API sms_unavailable qaytaradi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_TEMPLATE=TEGIO tasdiqlash kodi: {code}

# Faqat sinov uchun: kodni SMS o'rniga javobda qaytaradi. Jonli muhitda yoqmang.
# OTP_DEV_MODE=true

# To'lov
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=

# Yangi fikr xabari (B-32)
TELEGRAM_BOT_TOKEN=

# AI menyu va tarjima (B-14, B-15)
ANTHROPIC_API_KEY=
